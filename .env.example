# ---- App ----
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# ---- Database ----
DATABASE_URL=postgres://speakup:speakup@localhost:5432/speakup

# ---- Redis (matchmaking queue + online state) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- SMS / OTP provider (Twilio Verify, MSG91, or Firebase Auth Phone) ----
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=

# ---- WebRTC TURN server (production) ----
TURN_SERVER_URL=turn:your-turn-server.example.com:3478
TURN_USERNAME=
TURN_PASSWORD=

# ---- Object storage (profile photos) ----
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# ---- Payments ----
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---- OAuth (optional login methods) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Push notifications ----
FCM_SERVER_KEY=
APNS_KEY_ID=
